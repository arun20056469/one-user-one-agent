    {
      "id": "weekly_active_3d",
      "name": "Active on 3 distinct days within 7 days",
      "priority": 3,
      "window_days": 7,
      "eligibility": {
        "min_age_days": 1
      },
      "success": {
        "event": "app_open",
        "match": {},
        "min_count": 1,
        "distinct_days": 3
      },
      "underspecified": "Does an app open alone count as active, or must the viewer play something? Our interpretation (assumption): an app_open day counts only if it is followed by an episode_play on the same day."
    },
    {
      "id": "whatsapp_consent_5d",
      "name": "Gain WhatsApp consent within 5 days",
      "priority": 2,
      "window_days": 5,
      "eligibility": {
        "whatsapp_opt_in": false,
        "notifications_opt_in": true
      },
      "success": {
        "event": "consent_updated",
        "match": {
          "channel": [
            "whatsapp"
          ]
        },
        "min_count": 1
      }
    },
    {
      "id": "deepen_first_session_3d",
      "name": "Viewer starts a second title within 3 days",
      "priority": 2,
      "window_days": 3,
      "eligibility": {
        "completed_episode_count_in": [
          1
        ]
      },
      "success": {
        "event": "episode_play",
        "match": {},
        "min_count": 1
      },
      "underspecified": "It does not say whether the second play must be of a DIFFERENT content_slug than the first. Our interpretation (assumption): any episode_play inside the window counts."
    },
